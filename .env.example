APP_NAME="Obrador"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base central (panaderías y dominios). Cada panadería tiene su propia base,
# TENANT_DB_PREFIX + id (obrador_luna), que se crea al darla de alta con
# php artisan obrador:tenant-crear. El usuario necesita permiso CREATE DATABASE.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=obrador_central
DB_USERNAME=root
DB_PASSWORD=
TENANT_DB_PREFIX=obrador_

# Dominios propios del sistema, separados por coma. Cada panadería se
# atiende en un subdominio de ellos: luna.obrador.com
CENTRAL_DOMAINS=obrador.com,localhost,127.0.0.1

# Sesión y caché en "database": quedan dentro de la base de cada panadería.
# Con "file" se comparten entre panaderías y una cookie de una sirve en otra.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_APP_ID=com.panaderia.escritorio
NATIVEPHP_APP_VERSION=1.0.15
NATIVEPHP_APP_AUTHOR="INC Group"
NATIVEPHP_APP_COPYRIGHT="© 2026 INC Group. Todos los derechos reservados."
NATIVEPHP_APP_WEBSITE="https://www.linkedin.com/company/inc-groupbo/"

# Actualizaciones de la app de escritorio: los instaladores se publican como
# Releases en este repo (ver documentacion/actualizaciones.md).
# GITHUB_TOKEN solo hace falta para publicar (native:publish); no viaja en la app.
NATIVEPHP_UPDATER_ENABLED=true
GITHUB_OWNER=Rene-Marcelo-Ardaya
GITHUB_REPO=panaderia-releases
GITHUB_TOKEN=

NATIVEPHP_NSIS_DELETE_APP_DATA=false
