# Configuración de producción para docker compose (compose.yaml).
# Copiar a .env.produccion y completar. Ese archivo no se sube al repositorio.

APP_NAME=Obrador
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_URL=https://obrador.incgroupbo.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Dominio del sistema: portada, panel /panel y cada panadería bajo su id
# (obrador.incgroupbo.com/luna). Necesita un registro A hacia la IP del VPS.
CENTRAL_DOMAINS=obrador.incgroupbo.com
TENANT_DB_PREFIX=obrador_

# Solo con compose.caddy.yaml (VPS dedicado): correo para Let's Encrypt.
ACME_EMAIL=

# Base de datos. El host es el servicio "db" de compose.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=obrador_central
DB_USERNAME=obrador
DB_PASSWORD=

# Los mismos datos para crear la base y el usuario la primera vez (MariaDB).
# MARIADB_PASSWORD tiene que ser igual a DB_PASSWORD.
MARIADB_DATABASE=obrador_central
MARIADB_USER=obrador
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Sesión y caché en "database": quedan dentro de la base de cada panadería.
# Con "file" se comparten entre panaderías y una cookie de una sirve en otra.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# null: la cookie queda en el dominio exacto (cada panadería usa la suya, limitada a su ruta).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Los logs van a la salida del contenedor: docker compose logs -f app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
MAIL_MAILER=log
