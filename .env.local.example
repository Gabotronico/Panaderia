# Entorno local de desarrollo para docker compose (compose.local.yaml).
# Copiar a .env.local (lo hace docker/local/preparar.sh si no existe). Ese
# archivo no se sube al repositorio.
#
# Los secretos de aquí son de mentira y solo valen en esta máquina: nunca
# uses este archivo en el servidor (para eso está .env.produccion).

APP_NAME=Obrador
APP_ENV=local
APP_DEBUG=true
# Clave fija de desarrollo: no protege nada real y evita el paso de generarla.
APP_KEY=base64:v+TNMYW5qkofZTbVjDqO4wZo0+WvsBte8SG9i4Oiemc=
APP_URL=http://localhost:8094

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Dominio del sistema: la portada y el panel /panel. Cada panadería vive bajo
# su id en el mismo host (http://localhost:8094/luna), así que no hace falta
# tocar el archivo hosts.
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_DB_PREFIX=obrador_

# Base de datos. El host es el servicio "db" de compose.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=obrador_central
DB_USERNAME=obrador
DB_PASSWORD=obrador_local

# Los mismos datos para crear la base y el usuario la primera vez (MariaDB).
# MARIADB_PASSWORD tiene que ser igual a DB_PASSWORD.
MARIADB_DATABASE=obrador_central
MARIADB_USER=obrador
MARIADB_PASSWORD=obrador_local
MARIADB_ROOT_PASSWORD=root_local

# Sesión y caché en "database": quedan dentro de la base de cada panadería.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En local se entra por http, no por https.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Los logs van a la salida del contenedor: docker compose -f compose.local.yaml logs -f app
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Contraseñas rápidas de calcular: el entorno es local y las cuentas son de prueba.
BCRYPT_ROUNDS=4
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Lo lee docker/entrypoint.d/60-obrador.sh. En 0 no cachea configuración,
# eventos ni vistas: los cambios en el código se ven sin reiniciar.
OBRADOR_CACHEAR=0

# Secreto compartido con el panel central de INC Group para firmar las
# licencias (HMAC). En local es uno de mentira; en el servidor tiene que ser el
# mismo que use la función tenant-license-admin.
LICENCIA_SECRETO=obrador-local-secreto
